{
  "extends": "@repo/config/tsconfig",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "exactOptionalPropertyTypes": false,
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "nativewind-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
