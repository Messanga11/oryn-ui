{
  "name": "@oryn/ui",
  "version": "0.1.0",
  "description": "Universal component library for React + React Native (NativeWind + shadcn patterns)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives/*": "./src/primitives/*/index.tsx",
    "./layout/*": "./src/layout/*/index.tsx",
    "./components/*": "./src/components/*/index.tsx",
    "./patterns/*": "./src/patterns/*/index.tsx",
    "./blocks/*": "./src/blocks/*/index.tsx",
    "./tokens": "./src/tokens/index.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "nativewind": ">=4.0.0"
  },
  "dependencies": {
    "@tanstack/react-form": "^0.34.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "zod": "^3.22.0",
    "expo-image": "^1.12.0",
    "expo-linking": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0"
  }
}
